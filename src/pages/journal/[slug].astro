---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getAllPosts, formatDate } from '../../lib/sanity';
import { portableTextToHtml } from '../../lib/portable-text';
import type { Post } from '../../lib/sanity';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const bodyHtml = portableTextToHtml(post.body);
const isRemote = typeof post.image === 'string';
---

<Base
  title={`${post.title} — The Boat Yard Sauna Journal`}
  description={post.excerpt}
  ogType="article"
  publishedAt={post.publishedAt}
  ogImage={post.image}
>
  <article class="entry">

    <!-- Full-height hero: image fills the background, text sits on top -->
    <div class="entry__hero">
      {
        isRemote ? (
          <img class="entry__hero-img" src={post.image as string} alt={post.alt} loading="eager" decoding="async" />
        ) : (
          <Image
            class="entry__hero-img"
            src={post.image}
            alt={post.alt}
            width={2400}
            widths={[768, 1280, 2400]}
            sizes="100vw"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      <div class="entry__hero-overlay" aria-hidden="true"></div>

      <div class="entry__hero-content container">
        <a class="entry__back" href="/journal">← Back to the Journal</a>
        <header class="entry__head">
          <p class="entry__meta">
            <span class="entry__tag">{post.tag}</span>
            <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
          </p>
          <h1 class="entry__title">{post.title}</h1>
          {post.excerpt && <p class="entry__excerpt">{post.excerpt}</p>}
        </header>
      </div>
    </div>

    <!-- Body prose below the hero -->
    <div class="container entry__container">
      <div class="entry__body" set:html={bodyHtml} />
      <footer class="entry__footer">
        <a class="entry__back entry__back--dark link-underline" href="/journal">← Back to the Journal</a>
      </footer>
    </div>

  </article>
</Base>

<style>
  .entry {
    padding-bottom: var(--space-section);
  }

  /* ── Hero: full viewport height, image fills the background ── */
  .entry__hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }

  .entry__hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  /* Gradient: transparent at top → deep navy at bottom for text legibility */
  .entry__hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 29, 46, 0.25) 0%,
      rgba(11, 29, 46, 0.1) 35%,
      rgba(11, 29, 46, 0.65) 70%,
      rgba(11, 29, 46, 0.92) 100%
    );
  }

  /* Text content sits at the bottom of the hero */
  .entry__hero-content {
    position: relative;
    z-index: 1;
    max-width: 52rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(6rem, 12vw, 9rem);
  }

  .entry__back {
    display: inline-block;
    padding-block: 0.5em;
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(237, 242, 240, 0.7);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .entry__back:hover { color: var(--ink); }

  .entry__back--dark {
    color: var(--ink-soft);
  }

  .entry__head {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .entry__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--text-tiny);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(237, 242, 240, 0.6);
  }

  .entry__tag {
    color: var(--cedar);
    font-weight: 600;
  }

  .entry__title {
    margin-top: 0.9rem;
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 22ch;
    color: #edf2f0;
  }

  .entry__excerpt {
    margin-top: 1.1rem;
    max-width: 50ch;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
    color: rgba(237, 242, 240, 0.75);
  }

  /* ── Body prose ── */
  .entry__container {
    max-width: 44rem;
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .entry__body :global(p) {
    margin-top: 1.5em;
    font-size: clamp(1rem, 1.1vw, 1.1rem);
    line-height: 1.82;
    color: var(--ink-soft);
  }

  .entry__body :global(p:first-child) {
    margin-top: 0;
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    line-height: 1.75;
    color: var(--ink);
  }

  .entry__body :global(h2),
  .entry__body :global(h3),
  .entry__body :global(h4) {
    font-family: var(--font-display);
    font-weight: 440;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin-top: 2.5em;
    color: var(--ink);
  }

  .entry__body :global(h2) { font-size: var(--text-h3); }
  .entry__body :global(h3),
  .entry__body :global(h4) { font-size: clamp(1.2rem, 1.8vw, 1.5rem); }

  .entry__body :global(blockquote) {
    margin: 2.5em 0;
    padding: 1.4em 1.6em;
    border-left: 3px solid var(--cedar);
    background: rgba(200, 149, 108, 0.06);
    border-radius: 0 6px 6px 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.5;
    color: var(--ink);
  }

  .entry__body :global(ul),
  .entry__body :global(ol) {
    margin-top: 1.4em;
    padding-left: 1.4em;
    color: var(--ink-soft);
  }

  .entry__body :global(li) { margin-top: 0.6em; line-height: 1.75; }
  .entry__body :global(li::marker) { color: var(--cedar); }

  .entry__body :global(a) {
    color: var(--cedar);
    text-decoration-color: rgba(200, 149, 108, 0.4);
    text-underline-offset: 0.2em;
  }

  .entry__body :global(figure) { margin: 3em 0; }
  .entry__body :global(figure img) { width: 100%; border-radius: 6px; }

  .entry__body :global(code) {
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: 3px;
    background: var(--mist-10);
  }

  .entry__footer {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--mist-10);
  }
</style>
