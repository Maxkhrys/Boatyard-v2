---
// Fast-access grid — the first thing after the hero's "Book a Session" CTA.
// Surfaces the same destinations as the burger menu up front, so visitors
// don't have to scroll the whole page (or open the menu) to find them.
import { Image } from 'astro:assets';
import krystofImage from '../assets/images/sauna-hat-profile.jpg';
import wicklowImage from '../assets/images/wicklow-aerial-dusk.jpg';
import arklowImage from '../assets/images/arklow-aerial-quay.jpg';
import faqImage from '../assets/images/tide-clock-cedar.jpg';
import journalImage from '../assets/images/sea-swim-friends.jpg';

const onHome = Astro.url.pathname === '/';
const home = onHome ? '' : '/';

const links = [
  {
    eyebrow: 'Guided sauna session',
    title: "Krystof's Sessions",
    text: 'Join a guided sauna session, or book him privately.',
    cta: 'Meet Krystof',
    href: `${home}#krystof`,
    image: krystofImage,
    alt: 'A guest in a sauna hat looking out from the wood-fired barrel sauna during a guided session',
  },
  {
    eyebrow: 'Wicklow Harbour',
    title: 'Wicklow Booking',
    text: 'Book a sauna session at Wicklow Harbour.',
    cta: 'Book Wicklow',
    href: 'https://flutterwbdev.azurewebsites.net/#/tenantDetails?tenantName=The_boat_yard_sauna',
    external: true,
    image: wicklowImage,
    alt: 'Aerial view at dusk of The Boat Yard Sauna in Wicklow',
  },
  {
    eyebrow: 'Arklow Harbour',
    title: 'Arklow Booking',
    text: 'Book a sauna session at Arklow Harbour.',
    cta: 'Book Arklow',
    href: 'https://flutterwbdev.azurewebsites.net/#/tenantDetails?tenantName=The_Boat_Yard_Sauna_Arklow',
    external: true,
    image: arklowImage,
    alt: 'Aerial view of Arklow North Quay along the river',
  },
  {
    eyebrow: 'Good to know',
    title: 'FAQ',
    text: 'What to bring, booking rules, and more.',
    cta: 'Read FAQ',
    href: `${home}#tab-faq`,
    image: faqImage,
    alt: 'A cedar clock and warm coastal light',
  },
  {
    eyebrow: 'Journal',
    title: 'Journal',
    text: 'Sea temperatures, news, and swimmer stories.',
    cta: 'Read Journal',
    href: '/journal',
    image: journalImage,
    alt: 'Friends swimming together in the sea',
  },
];
---

<section class="quicklinks" aria-label="Quick links">
  <div class="container">
    <div class="quicklinks__grid">
      {
        links.map((link) => (
          <a
            class="quicklinks__card"
            href={link.href}
            data-reveal
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            <div class="quicklinks__media">
              <Image
                src={link.image}
                alt={link.alt}
                widths={[320, 480]}
                sizes="(min-width: 900px) 20vw, (min-width: 560px) 46vw, 92vw"
                format="webp"
                quality={68}
                loading="eager"
              />
              <span class="quicklinks__eyebrow-badge">{link.eyebrow}</span>
            </div>
            <div class="quicklinks__body">
              <h3 class="quicklinks__title">{link.title}</h3>
              <p class="quicklinks__text">{link.text}</p>
              <span class="quicklinks__cta">
                {link.cta}
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .quicklinks {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .quicklinks__grid {
    display: grid;
    gap: clamp(1.1rem, 2vw, 1.5rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 560px) {
    .quicklinks__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .quicklinks__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .quicklinks__card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--mist-10);
    border-radius: 10px;
    overflow: hidden;
    background: rgba(237, 242, 240, 0.02);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .quicklinks__card:hover {
    border-color: var(--cedar);
    transform: translateY(-3px);
  }

  .quicklinks__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .quicklinks__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }

  .quicklinks__card:hover .quicklinks__media img {
    transform: scale(1.06);
  }

  .quicklinks__eyebrow-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.35em 0.8em;
    border-radius: 999px;
    background: rgba(11, 29, 46, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: var(--text-tiny);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cedar);
    pointer-events: none;
  }

  .quicklinks__body {
    padding: 1.1rem 1.15rem 1.3rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .quicklinks__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 480;
  }

  .quicklinks__text {
    margin-top: 0.4rem;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--ink-soft);
    flex-grow: 1;
  }

  .quicklinks__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.9rem;
    padding: 0.55em 1.1em;
    border: 1px solid var(--mist-25);
    border-radius: 999px;
    font-size: var(--text-tiny);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      gap var(--dur) var(--ease);
  }

  .quicklinks__card:hover .quicklinks__cta {
    border-color: var(--cedar);
    color: var(--cedar);
    gap: 0.75em;
  }

  @media (prefers-reduced-motion: reduce) {
    .quicklinks__card:hover .quicklinks__media img {
      transform: none;
    }
  }
</style>
