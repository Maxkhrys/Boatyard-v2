<aside class="privacy-notice" id="privacy-notice" aria-label="Cookie preferences" hidden>
  <div class="privacy-notice__copy">
    <p class="privacy-notice__title">Your cookie choices</p>
    <p>
      We use essential browser storage to remember your privacy choice. Optional analytics cookies
      are currently switched off and will never load without your permission.
      <a href="/privacy">Read our privacy policy</a>.
    </p>
  </div>

  <div class="privacy-notice__actions">
    <button class="btn btn--ghost privacy-notice__reject" id="privacy-notice-reject" type="button">
      Reject optional
    </button>
    <button class="btn btn--primary" id="privacy-notice-accept" type="button">
      Accept optional
    </button>
  </div>
</aside>

<script>
  const notice = document.getElementById('privacy-notice');
  const accept = document.getElementById('privacy-notice-accept');
  const reject = document.getElementById('privacy-notice-reject');
  const storageKey = 'boatyard-cookie-preferences-v1';

  const readChoice = () => {
    try {
      return localStorage.getItem(storageKey);
    } catch {
      return null;
    }
  };

  const saveChoice = (choice: 'accepted' | 'rejected') => {
    try {
      localStorage.setItem(storageKey, choice);
    } catch {
      // The site remains usable when browser storage is unavailable.
    }
    if (notice) notice.hidden = true;
  };

  if (notice && accept && reject) {
    notice.hidden = Boolean(readChoice());
    accept.addEventListener('click', () => saveChoice('accepted'));
    reject.addEventListener('click', () => saveChoice('rejected'));

    window.addEventListener('boatyard:open-cookie-preferences', () => {
      notice.hidden = false;
    });
  }
</script>

<style>
  .privacy-notice {
    position: fixed;
    z-index: 1000;
    inset-inline: 1rem;
    bottom: 1rem;
    width: min(48rem, calc(100% - 2rem));
    margin-inline: auto;
    padding: 1rem;
    border: 1px solid var(--mist-10);
    border-radius: 0.85rem;
    background: rgba(8, 21, 34, 0.97);
    box-shadow: 0 1.25rem 4rem rgba(0, 0, 0, 0.35);
    color: var(--ink-soft);
  }

  .privacy-notice[hidden] {
    display: none;
  }

  .privacy-notice__copy {
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .privacy-notice__title {
    margin-bottom: 0.2rem;
    color: var(--ink);
    font-weight: 600;
  }

  .privacy-notice a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .privacy-notice__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .privacy-notice__actions .btn {
    flex: 1 1 10rem;
    white-space: nowrap;
  }

  @media (min-width: 700px) {
    .privacy-notice {
      padding: 1.1rem 1.2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .privacy-notice__actions {
      flex: 0 0 auto;
      margin-top: 0;
    }
  }
</style>
