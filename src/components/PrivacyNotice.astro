<aside class="privacy-notice" id="privacy-notice" aria-label="Privacy notice" hidden>
  <div class="privacy-notice__copy">
    <p class="privacy-notice__title">Your privacy</p>
    <p>
      We use only essential browser storage on this website. If you subscribe, buy a voucher, or
      book through a linked service, your details are used to provide that service.
      <a href="/privacy">Read our privacy policy</a>.
    </p>
  </div>
  <button class="btn btn--primary privacy-notice__accept" id="privacy-notice-accept" type="button">
    Accept &amp; continue
  </button>
</aside>

<script>
  const notice = document.getElementById('privacy-notice');
  const accept = document.getElementById('privacy-notice-accept');
  const storageKey = 'boatyard-privacy-notice-v1';

  if (notice && accept) {
    try {
      notice.hidden = localStorage.getItem(storageKey) === 'accepted';
    } catch {
      notice.hidden = false;
    }

    accept.addEventListener('click', () => {
      try {
        localStorage.setItem(storageKey, 'accepted');
      } catch {
        // The acknowledgement still works when browser storage is unavailable.
      }
      notice.hidden = true;
    });
  }
</script>

<style>
  .privacy-notice {
    position: fixed;
    z-index: 1000;
    inset-inline: 1rem;
    bottom: 1rem;
    width: min(46rem, calc(100% - 2rem));
    margin-inline: auto;
    padding: 1rem;
    border: 1px solid var(--mist-10);
    border-radius: 0.85rem;
    background: rgba(8, 21, 34, 0.97);
    box-shadow: 0 1.25rem 4rem rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--ink-soft);
  }

  .privacy-notice[hidden] {
    display: none;
  }

  .privacy-notice__copy {
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .privacy-notice__title {
    margin-bottom: 0.2rem;
    color: var(--ink);
    font-weight: 600;
  }

  .privacy-notice a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .privacy-notice__accept {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  @media (min-width: 700px) {
    .privacy-notice {
      padding: 1.1rem 1.2rem;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
