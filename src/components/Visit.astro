---

<section class="visit section" id="visit">
  <div class="container">
    <p class="eyebrow" data-reveal>Good to know</p>
    <h2 class="visit__heading" data-reveal>Everything for your visit.</h2>

    <div class="visit__panel" data-reveal>
      <div class="visit__tablist" role="tablist" aria-label="Visitor information">
        {
          tabs.map((tab, index) => (
            <button
              class="visit__tab"
              role="tab"
              type="button"
              id={`tab-${tab.id}`}
              aria-controls={`panel-${tab.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? '0' : '-1'}
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      {
        tabs.map((tab, index) => (
          <div
            class="visit__tabpanel"
            role="tabpanel"
            id={`panel-${tab.id}`}
            aria-labelledby={`tab-${tab.id}`}
            hidden={index !== 0}
          >
            {tab.intro && <p class="visit__intro">{tab.intro}</p>}

            {tab.kind === 'steps' && (
              <ol class="visit__steps">
                {tab.steps!.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            )}

            {tab.kind === 'list' && (
              <ul class="visit__checklist">
                {tab.items!.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}

            {tab.kind === 'prose' &&
              tab.body!.map((p) => <p class="visit__prose">{p}</p>)}

            {tab.kind === 'process' && (
              <>
                <ol class="visit__process">
                  {tab.steps!.map((step) => (
                    <li>
                      <h3 class="visit__process-title">{step.title}</h3>
                      <p class="visit__process-body" set:html={step.body} />
                      {step.note && <p class="visit__process-note">{step.note}</p>}
                    </li>
                  ))}
                </ol>

                <div class="visit__process-confirm">
                  <p>Your booking is only confirmed once:</p>
                  <ul class="visit__checklist">
                    {tab.confirmItems!.map((item) => <li set:html={item} />)}
                  </ul>
                  <p class="visit__process-note" set:html={tab.outro} />
                </div>

                <a class="btn btn--primary visit__process-cta" href={tab.cta!.href}>
                  {tab.cta!.label}
                </a>
              </>
            )}

            {tab.kind === 'faq' && (
              <dl class="visit__faq">
                {tab.qa!.map((item) => (
                  <div class="visit__faq-item">
                    <dt>{item.q}</dt>
                    <dd set:html={item.a} />
                  </div>
                ))}
              </dl>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.visit__panel').forEach((panel) => {
    const tabs = Array.from(panel.querySelectorAll<HTMLButtonElement>('.visit__tab'));
    const panels = Array.from(panel.querySelectorAll<HTMLElement>('.visit__tabpanel'));

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.setAttribute('tabindex', selected ? '0' : '-1');
        panels[i].hidden = !selected;
      });
      if (focus) tabs[index].focus();
    };

    const selectFromHash = () => {
      const hashIndex = tabs.findIndex((tab) => tab.id === window.location.hash.slice(1));
      if (hashIndex > -1) select(hashIndex, false);
    };
    selectFromHash();
    window.addEventListener('hashchange', selectFromHash);

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index, false));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next);
      });
    });
  });
</script>

<style>
  .visit__heading {
    font-size: var(--text-h2);
    margin-top: 1.5rem;
  }

  .visit__panel {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .visit__tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--mist-10);
  }

  .visit__tab {
    padding: 0.7em 1.3em;
    border: 1px solid var(--mist-10);
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .visit__tab:hover {
    border-color: var(--cedar);
    color: var(--ink);
  }

  .visit__tab[aria-selected='true'] {
    background: var(--cedar);
    border-color: var(--cedar);
    color: var(--navy-deep);
  }

  .visit__tabpanel {
    padding-top: clamp(2rem, 4vw, 3rem);
    max-width: 70ch;
  }

  .visit__tabpanel[hidden] {
    display: none;
  }

  .visit__intro {
    color: var(--ink-soft);
    margin-bottom: 1.75rem;
  }

  /* Numbered steps */
  .visit__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    display: grid;
    gap: 1.1rem;
  }

  .visit__steps li {
    counter-increment: step;
    position: relative;
    padding-left: 3rem;
    color: var(--ink-soft);
    min-height: 2rem;
    display: flex;
    align-items: center;
  }

  .visit__steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(200, 149, 108, 0.45);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--cedar);
  }

  /* Checklist */
  .visit__checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .visit__checklist li {
    position: relative;
    padding-left: 1.9rem;
    color: var(--ink-soft);
  }

  .visit__checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--cedar);
  }

  /* Private-session process */
  .visit__process {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: process-step;
    display: grid;
    gap: 1.75rem;
  }

  .visit__process > li {
    counter-increment: process-step;
    position: relative;
    padding-left: 3rem;
  }

  .visit__process > li::before {
    content: counter(process-step);
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(200, 149, 108, 0.45);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--cedar);
  }

  .visit__process-title {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    font-weight: 480;
  }

  .visit__process-body {
    margin-top: 0.4rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .visit__process-body a {
    color: var(--cedar);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .visit__process-note {
    margin-top: 0.6rem;
    font-size: var(--text-small);
    font-style: italic;
    color: var(--ink-mid);
  }

  .visit__process-confirm {
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--mist-10);
  }

  .visit__process-confirm > p:first-child {
    font-weight: 600;
  }

  .visit__process-confirm .visit__checklist {
    margin-top: 1rem;
  }

  .visit__process-cta {
    margin-top: 2rem;
  }

  .visit__prose {
    color: var(--ink-soft);
  }

  .visit__prose + .visit__prose {
    margin-top: 1.25rem;
  }

  /* FAQ */
  .visit__faq {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .visit__faq-item {
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--mist-10);
  }

  .visit__faq-item:first-child {
    padding-top: 0;
  }

  .visit__faq dt {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    font-weight: 480;
    color: var(--ink);
  }

  .visit__faq dd {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: var(--text-small);
    line-height: 1.7;
  }

  .visit__faq dd a {
    color: var(--cedar);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
