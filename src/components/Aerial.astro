---
import { Image } from 'astro:assets';
import img1 from '../assets/images/sauna-courtyard-night.jpg';
import img2 from '../assets/images/sauna-flower-planter.jpg';
import imgFuchsia from '../assets/images/fuchsia-bamboo-stone.jpg';
import imgChimney from '../assets/images/sauna-chimney-smoke.jpg';
import imgTideClock from '../assets/images/tide-clock-cedar.jpg';
import imgLifeRing from '../assets/images/life-ring-reeds.jpg';
import img9 from '../assets/images/ritual-oils-incense.jpeg';
import img5 from '../assets/images/harbour-dusk-boats.jpeg';
import img6 from '../assets/images/pier-lighthouse-sunrise.jpeg';
import img8 from '../assets/images/aerial-wicklow-harbour.jpg';
---

<section class="gallery section" id="gallery" aria-label="Photo gallery">
  <div class="container">
    <p class="eyebrow" data-reveal>Life at the water</p>
  </div>

  <div class="gallery__grid container">
    <!-- Row 1: wide hero + portrait -->
    <figure class="gallery__item gallery__item--a">
      <div class="gallery__media" data-media data-parallax="3">
        <Image src={img1} alt="Sauna courtyard lit at night with people relaxing outside"
          width={1400} widths={[640,1000,1400]} sizes="(min-width:900px) 62vw, 92vw"
          format="webp" quality={80} loading="lazy" />
      </div>
    </figure>

    <figure class="gallery__item gallery__item--b">
      <div class="gallery__media" data-media data-parallax="5">
        <Image src={img2} alt="Pink carnations and lavender in a planter beside the barrel sauna"
          width={900} widths={[480,700,900]} sizes="(min-width:900px) 30vw, 44vw"
          format="webp" quality={80} loading="lazy" />
      </div>
    </figure>

    <!-- Row 2: three squares -->
    <figure class="gallery__item gallery__item--c">
      <div class="gallery__media" data-media data-parallax="4">
        <Image src={imgFuchsia} alt="Fuchsia flowers and bamboo against weathered stone"
          width={800} widths={[480,800]} sizes="(min-width:900px) 28vw, 44vw"
          format="webp" quality={80} loading="lazy" />
      </div>
    </figure>

    <figure class="gallery__item gallery__item--i">
      <div class="gallery__media" data-media data-parallax="3">
        <Image src={imgTideClock} alt="A handmade tide clock mounted on the cedar wall"
          width={800} widths={[480,800]} sizes="(min-width:900px) 28vw, 44vw"
          format="webp" quality={80} loading="lazy" />
      </div>
    </figure>

    <figure class="gallery__item gallery__item--d">
      <div class="gallery__media" data-media data-parallax="5">
        <Image src={imgChimney} alt="Smoke rising from the wood-fired sauna's chimney at dusk"
          width={800} widths={[480,800]} sizes="(min-width:900px) 28vw, 44vw"
          format="webp" quality={80} loading="lazy" />
      </div>
    </figure>

    <!-- Row 3: moody portrait + landscape pairing -->
    <figure class="gallery__item gallery__item--j">
      <div class="gallery__media" data-media data-parallax="3">
        <Image src={imgLifeRing} alt="A red life ring glimpsed through dried reeds at night"
          width={760} widths={[480,760]} sizes="(min-width:900px) 36vw, 92vw"
          format="webp" quality={80} loading="lazy" />
      </div>
    </figure>

    <figure class="gallery__item gallery__item--e">
      <div class="gallery__media" data-media data-parallax="5">
        <Image src={img9} alt="Ritual oils and incense on cedar wood"
          width={1100} widths={[640,900,1100]} sizes="(min-width:900px) 50vw, 92vw"
          format="webp" quality={80} loading="lazy" />
      </div>
    </figure>

    <!-- Row 4: two side by side -->
    <figure class="gallery__item gallery__item--f">
      <div class="gallery__media" data-media data-parallax="4">
        <Image src={img5} alt="Harbour at dusk with boats moored along the quay"
          width={1000} widths={[640,1000]} sizes="(min-width:900px) 45vw, 92vw"
          format="webp" quality={78} loading="lazy" />
      </div>
    </figure>

    <figure class="gallery__item gallery__item--g">
      <div class="gallery__media" data-media data-parallax="3">
        <Image src={img6} alt="Pier and lighthouse at sunrise, Wicklow"
          width={760} widths={[480,760]} sizes="(min-width:900px) 38vw, 92vw"
          format="webp" quality={78} loading="lazy" />
      </div>
    </figure>

    <!-- Row 5: full-width banner -->
    <figure class="gallery__item gallery__item--h">
      <div class="gallery__media" data-media data-parallax="2">
        <Image src={img8} alt="Aerial view of Wicklow harbour on a clear day"
          width={1800} widths={[960,1400,1800]} sizes="92vw"
          format="webp" quality={76} loading="lazy" />
      </div>
    </figure>
  </div>
</section>

<style>
  .gallery {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .gallery__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.85rem, 1.6vw, 1.5rem);
  }

  .gallery__item {
    margin: 0;
    overflow: hidden;
    border-radius: 6px;
  }

  .gallery__media {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 6px;
  }

  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s var(--ease);
  }

  @media (hover: hover) {
    .gallery__item:hover :global(img) {
      transform: scale(1.045);
    }
  }

  /* Mobile: simple 2-col stack */
  .gallery__item--a { grid-column: 1 / -1; aspect-ratio: 4/3; }
  .gallery__item--b { aspect-ratio: 3/4; }
  .gallery__item--c { aspect-ratio: 1/1; }
  .gallery__item--i { aspect-ratio: 1/1; }
  .gallery__item--d { grid-column: 1 / -1; aspect-ratio: 16/7; }
  .gallery__item--j { aspect-ratio: 3/4; }
  .gallery__item--e { aspect-ratio: 3/4; }
  .gallery__item--f { grid-column: 1 / -1; aspect-ratio: 4/3; }
  .gallery__item--g { grid-column: 1 / -1; aspect-ratio: 4/3; }
  .gallery__item--h { grid-column: 1 / -1; aspect-ratio: 21/9; }

  @media (min-width: 900px) {
    .gallery__grid {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: auto auto auto auto auto;
    }

    /* Row 1: wide hero + portrait */
    .gallery__item--a { grid-column: 1 / 9; grid-row: 1; aspect-ratio: 3/2; }
    .gallery__item--b { grid-column: 9 / 13; grid-row: 1; aspect-ratio: 3/4; }

    /* Row 2: three squares */
    .gallery__item--c { grid-column: 1 / 5; grid-row: 2; aspect-ratio: 1/1; }
    .gallery__item--i { grid-column: 5 / 9; grid-row: 2; aspect-ratio: 1/1; }
    .gallery__item--d { grid-column: 9 / 13; grid-row: 2; aspect-ratio: 1/1; }

    /* Row 3: moody portrait + landscape pairing */
    .gallery__item--j { grid-column: 1 / 6; grid-row: 3; aspect-ratio: 3/4; }
    .gallery__item--e { grid-column: 6 / 13; grid-row: 3; aspect-ratio: 16/9; }

    /* Row 4 */
    .gallery__item--f { grid-column: 1 / 7; grid-row: 4; aspect-ratio: 4/3; }
    .gallery__item--g { grid-column: 7 / 13; grid-row: 4; aspect-ratio: 4/3; }

    /* Row 5: full-width banner */
    .gallery__item--h { grid-column: 1 / -1; grid-row: 5; aspect-ratio: 21/8; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__item:hover :global(img) {
      transform: none;
    }
  }
</style>
